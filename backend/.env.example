# Скопируйте в backend/.env и заполните. .env не коммитится.

# Провайдер модели: mock | anthropic | openai
#   mock      — без сети и ключа, детерминированные эвристики (демо, тесты)
#   anthropic — Claude через официальный SDK anthropic
#   openai    — любой OpenAI-совместимый chat.completions (OpenAI, Gemini, Ollama, vLLM) через LLM_BASE_URL
LLM_PROVIDER=mock
# Пусто = по умолчанию: anthropic -> claude-opus-5-5
LLM_MODEL=
LLM_API_KEY=
# Для openai-compat, например:
#   https://api.openai.com/v1
#   https://generativelanguage.googleapis.com/v1beta/openai
#   http://localhost:11434/v1   (Ollama, ключ не нужен)
LLM_BASE_URL=
# Только anthropic: глубина рассуждений low|medium|high|xhigh|max и серверный fallback при отказе (1/0)
LLM_EFFORT=medium
LLM_FALLBACKS=1

# Цена за 1 млн токенов, USD — для cost_usd в оценке (пусто = не считать).
# Пример для claude-opus-5-5: 4 и 20
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=

# Полная ссылка GET API организаторов для DEV. group_id подставляется в {group_id}
# или добавляется параметром ?group_id=...
ORGANIZER_API_URL=

EVAL_CONCURRENCY=4
DB_PATH=cqa.db
